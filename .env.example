# ==============================================================================
# DevHub Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env BEFORE RUNNING:
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux / macOS:      cp .env.example .env
#
# DO NOT COMMIT THE ACTUAL .env FILE CONTAINING SENSITIVE DATA TO VERSION CONTROL!
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=devhub
POSTGRES_PASSWORD=devhub_insecure_dev_password_change_in_prod
POSTGRES_DB=devhub_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend API Configuration
ENVIRONMENT=development
PORT=8000
DATABASE_URL=postgresql+psycopg2://devhub:devhub_insecure_dev_password_change_in_prod@db:5432/devhub_db
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5173

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_BASE_URL=/api

# Optional: Docker Model Runner / Gordon configuration
MODEL_RUNNER_ENABLED=false
MODEL_RUNNER_URL=http://localhost:11434
